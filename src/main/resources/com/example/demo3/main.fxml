<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.geometry.Insets?>

<VBox fx:controller="com.example.demo3.MainController"
      xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/21"
      alignment="CENTER" prefHeight="400.0" prefWidth="600.0" spacing="20">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    <children>
        <Label text="Welcome to the Dashboard!"/>
        <Label fx:id="userRoleLabel" text="Role:"/>
        <Label fx:id="loggedInUserLabel" text="Logged in as:"/>
    </children>
</VBox>