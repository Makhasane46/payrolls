<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo3.EmployeeDashboardController">
    <top>
        <Label text="Employee Management" BorderPane.alignment="CENTER">
            <BorderPane.margin>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </BorderPane.margin>
        </Label>
    </top>
    <center>
        <TableView fx:id="employeeTable" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="employeeIdColumn" prefWidth="75.0" text="Employee ID" />
                <TableColumn fx:id="nameColumn" prefWidth="75.0" text="Name" />
                <TableColumn fx:id="departmentColumn" prefWidth="75.0" text="Department" />
                <TableColumn fx:id="positionColumn" prefWidth="75.0" text="Position" />
                <TableColumn fx:id="basicSalaryColumn" prefWidth="75.0" text="Basic Salary" />
                <TableColumn fx:id="workingHoursColumn" prefWidth="75.0" text="Working Hours" />
            </columns>
        </TableView>
    </center>
    <bottom>
        <VBox prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                    <children>
                        <Label text="Employee ID:" />
                        <TextField fx:id="employeeIdField" prefWidth="100.0">
                            <HBox.margin>
                                <Insets left="5.0" right="10.0" />
                            </HBox.margin>
                        </TextField>
                        <Label text="Name:" />
                        <TextField fx:id="nameField" prefWidth="100.0">
                            <HBox.margin>
                                <Insets left="5.0" right="10.0" />
                            </HBox.margin>
                        </TextField>
                    </children>
                </HBox>
                <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                    <children>
                        <Label text="Department:" />
                        <TextField fx:id="departmentField" prefWidth="100.0">
                            <HBox.margin>
                                <Insets left="5.0" right="10.0" />
                            </HBox.margin>
                        </TextField>
                        <Label text="Position:" />
                        <TextField fx:id="positionField" prefWidth="100.0">
                            <HBox.margin>
                                <Insets left="5.0" right="10.0" />
                            </HBox.margin>
                        </TextField>
                    </children>
                </HBox>
                <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                    <children>
                        <Label text="Basic Salary:" />
                        <TextField fx:id="basicSalaryField" prefWidth="100.0">
                            <HBox.margin>
                                <Insets left="5.0" right="10.0" />
                            </HBox.margin>
                        </TextField>
                        <Label text="Working Hours:" />
                        <TextField fx:id="workingHoursField" prefWidth="100.0">
                            <HBox.margin>
                                <Insets left="5.0" right="10.0" />
                            </HBox.margin>
                        </TextField>
                    </children>
                </HBox>
                <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                    <children>
                        <Button fx:id="addButton" mnemonicParsing="false" onAction="#addEmployee" text="Add">
                            <HBox.margin>
                                <Insets left="10.0" right="10.0" />
                            </HBox.margin>
                        </Button>
                        <Button fx:id="updateButton" mnemonicParsing="false" onAction="#updateEmployee" text="Update">
                            <HBox.margin>
                                <Insets left="10.0" right="10.0" />
                            </HBox.margin>
                        </Button>
                        <Button fx:id="deleteButton" mnemonicParsing="false" onAction="#deleteEmployee" text="Delete">
                            <HBox.margin>
                                <Insets left="10.0" right="10.0" />
                            </HBox.margin>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>
    </bottom>
</BorderPane>