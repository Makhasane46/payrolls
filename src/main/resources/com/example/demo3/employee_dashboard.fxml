<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.demo3.EmployeeDashboardController">

    <top>
        <HBox style="-fx-background-color: #8B0000;" alignment="CENTER_LEFT" spacing="20.0"
              BorderPane.alignment="CENTER">
            <padding>
                <Insets top="10.0" bottom="10.0" left="20.0" right="20.0"/>
            </padding>
            <children>
                <Label text="Payroll Management System" style="-fx-text-fill: white;">
                    <font>
                        <Font size="20.0"/>
                    </font>
                </Label>
                <Label fx:id="welcomeLabel" text="Welcome," style="-fx-text-fill: white;"/>
                <Button text="Logout" onAction="#logout" style="-fx-background-color: transparent; -fx-text-fill: white;"/>
            </children>
        </HBox>
    </top>

    <left>
        <VBox style="-fx-background-color: black;" prefWidth="150.0" spacing="10.0">
            <padding>
                <Insets top="20.0" bottom="20.0" left="10.0" right="10.0"/>
            </padding>
            <children>
                <Button text="Dashboard (Home)" style="-fx-text-fill: white; -fx-background-color: transparent;"
                        onAction="#goToDashboard"/>
                <Button text="View My Payslips" style="-fx-text-fill: white; -fx-background-color: transparent;"
                        onAction="#goToViewMyPayslips"/>
                <Button text="My Salary Breakdown" style="-fx-text-fill: white; -fx-background-color: transparent;"
                        onAction="#goToMySalaryBreakdown"/>
                <Button text="Logout" style="-fx-text-fill: white; -fx-background-color: transparent;"
                        onAction="#logout"/>
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="20.0" alignment="CENTER">
            <padding>
                <Insets top="20.0" bottom="20.0" left="20.0" right="20.0"/>
            </padding>
            <children>
                <Label text="Personal Information" style="-fx-font-weight: bold;">
                    <font>
                        <Font size="16.0"/>
                    </font>
                </Label>
                <HBox spacing="10.0">
                    <children>
                        <Label text="Name:"/>
                        <Label fx:id="nameLabel" text="[Name]"/>
                    </children>
                </HBox>
                <HBox spacing="10.0">
                    <children>
                        <Label text="Department:"/>
                        <Label fx:id="departmentLabel" text="[Department]"/>
                    </children>
                </HBox>
                <HBox spacing="10.0">
                    <children>
                        <Label text="Position:"/>
                        <Label fx:id="positionLabel" text="[Position]"/>
                    </children>
                </HBox>
                <HBox spacing="10.0">
                    <children>
                        <Label text="Basic Salary:"/>
                        <Label fx:id="basicSalaryLabel" text="[Basic Salary]"/>
                    </children>
                </HBox>
                <HBox spacing="10.0">
                    <children>
                        <Label text="Working Hours:"/>
                        <Label fx:id="workingHoursLabel" text="[Working Hours]"/>
                    </children>
                </HBox>

                <Label text="Current Month Salary" style="-fx-font-weight: bold;">
                    <font>
                        <Font size="16.0"/>
                    </font>
                </Label>
                <HBox spacing="10.0">
                    <children>
                        <Label text="Net Salary:"/>
                        <Label fx:id="netSalaryLabel" text="[Net Salary]"/>
                    </children>
                </HBox>
                <HBox spacing="10.0">
                    <children>
                        <Label text="Gross Salary:"/>
                        <Label fx:id="grossSalaryLabel" text="[Gross Salary]"/>
                    </children>
                </HBox>
                <HBox spacing="10.0">
                    <children>
                        <Label text="Deductions:"/>
                        <Label fx:id="deductionsLabel" text="[Deductions]"/>
                    </children>
                </HBox>

                <LineChart fx:id="salaryOverTimeChart">
                    <xAxis>
                        <CategoryAxis label="Month"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Salary"/>
                    </yAxis>
                </LineChart>

                <Button text="Download Payslip (PDF)" onAction="#downloadPayslip"/>
            </children>
        </VBox>
    </center>

</BorderPane>